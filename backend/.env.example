# Application
PORT=3000
API_VERSION=1
NODE_ENV=development

# Database (PostgreSQL / TypeORM)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=nest_project

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sentry (optional)
SENTRY_DSN=

# Frontend origin allowed to call the API (CORS)
CORS_ORIGIN=http://localhost:3001

# Demo login (development only, never enable in production): when "true", an empty
# phoneNumber and password on POST /api/v1/auth/login returns tokens for a built-in demo admin
DEMO_LOGIN_ENABLED=false