{
  "tabWidth": 2,
  "printWidth": 100,
  "endOfLine": "lf",
  "objectWrap": "collapse",
  "quoteProps": "consistent",
  "arrowParens": "avoid",
  "trailingComma": "es5",
  "semi": false,
  "useTabs": true,
  "singleQuote": true,
  "bracketSpacing": true,
  "jsxSingleQuote": true,
  "bracketSameLine": false,
  "singleAttributePerLine": true
}
